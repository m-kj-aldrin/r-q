<ul target="users">
	{% for user in users %}
	<li data-user>
		<ul>
			<li>
				<re-quest endpoint="/users/{{user.id}}" method="DELETE" fire-on="click">
					<button>delete</button>
				</re-quest>
			</li>
			{% for k,v in user.items() %}
			<li>
				{{k}}: {{v}}
			</li>
			{% endfor %}
		</ul>
	</li>
	{% endfor %}
</ul>